<resources>
    <!-- Default line spacing multiplier between hours and minutes of the keyguard clock -->
    <item name="keyguard_clock_line_spacing_scale" type="dimen" format="float">.7</item>

    <!-- Blur radius used by SystemUI -->
    <dimen name="min_window_blur_radius">1px</dimen>
    <dimen name="max_window_blur_radius">17.5px</dimen>

    <!-- Pocket Mode -->
    <style name="pocket_view_title">
        <item name="android:fontFamily">@string/config_headlineFontFamily</item>
        <item name="android:textSize">@dimen/pocket_view_title_size</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:alpha">0.87</item>
    </style>
    <style name="pocket_view_title_cancel">
        <item name="android:textSize">@dimen/pocket_view_title_cancel_size</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:alpha">0.54</item>
    </style>
    <style name="pocket_view_top_tag">
        <item name="android:textSize">@dimen/pocket_view_top_tag_size</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:alpha">0.54</item>
    </style>
</resources>
