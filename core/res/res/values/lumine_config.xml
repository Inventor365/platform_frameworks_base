<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Define device configs on boot -->
    <string-array name="global_device_configs_override" translatable="false">
    </string-array>
    <string-array name="device_configs_override" translatable="false">
    </string-array>

    <!-- Paths to the libraries that contain device specific key handlers -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
    </string-array>

    <!-- Names of the key handler classes -->
    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
    </string-array>

    <!-- Should we listen for fingerprints when the screen is off?  Devices
         with a rear-mounted sensor want this, but certain devices have
         the sensor embedded in the power key and listening all the time
         causes a poor experience. -->
    <bool name="config_fingerprintWakeAndUnlock">true</bool>

    <!-- Whether to cleanup fingerprints upon connection to the daemon and when user switches -->
    <bool name="config_cleanupUnusedFingerprints">true</bool>

    <!-- Name of a font family to use as light font. For theming purpose. -->
    <string name="config_lightFontFamily" translatable="false">sans-serif-light</string>

    <!-- Name of a font family to use as regular font. For theming purpose. -->
    <string name="config_regularFontFamily" translatable="false">sans-serif-regular</string>

    <string-array name="config_launcherComponents">
        <item>com.google.android.apps.nexuslauncher/com.android.quickstep.RecentsActivity</item>
        <item>com.android.launcher3/com.android.quickstep.RecentsActivity</item>
    </string-array>
    
    <string-array name="config_launcherPackages">
        <item>com.google.android.apps.nexuslauncher</item>
        <item>com.android.launcher3</item>
    </string-array>

    <!-- Whitelist of package names to bypass foreground service type validation -->
    <string-array name="config_fgsTypeValidationBypassPackages" translatable="false"/>

    <!-- Whitelist of package names to bypass alarm manager validation -->
    <string-array name="config_alarmManagerValidationBypassPackages" translatable="false"/>

    <!-- Whitelist of package names to bypass broadcast reciever validation -->
    <string-array name="config_broadcaseReceiverValidationBypassPackages" translatable="false"/>

    <!-- Keybox configuration for device certification -->
    <string-array name="config_certifiedKeybox" translatable="false">
     <!--
       Keybox entries for EC and RSA keys and certificates.
       These should be populated with valid data for device certification.
       <item>EC.PRIV:</item>
       <item>EC.CERT_1:</item>
       <item>EC.CERT_2:</item>
       <item>EC.CERT_3:</item>
       <item>RSA.PRIV:</item>
       <item>RSA.CERT_1:</item>
       <item>RSA.CERT_2:</item>
       <item>RSA.CERT_3:</item>
     -->
    </string-array>

    <!-- Defines the actions shown in advanced reboot submenu -->
    <string-array name="config_restartActionsList">
       <item>restart</item>
       <item>restart_recovery</item>
       <item>restart_bootloader</item>
       <item>restart_fastboot</item>
    </string-array>
</resources>
